{
  "name": "cf-slack-support",
  "version": "0.0.1",
  "description": "Cloudflare Durable Objects + Slack customer support bridge with optional feature plugins",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "default": "./src/media/index.ts"
    },
    "./channel-index": {
      "types": "./src/channel-index/index.ts",
      "default": "./src/channel-index/index.ts"
    },
    "./slack": {
      "types": "./src/slack/index.ts",
      "default": "./src/slack/index.ts"
    },
    "./emoji": {
      "types": "./src/emoji/index.ts",
      "default": "./src/emoji/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol/index.ts",
      "default": "./src/protocol/index.ts"
    },
    "./channel": {
      "types": "./src/channel/index.ts",
      "default": "./src/channel/index.ts"
    },
    "./features/reactions": {
      "types": "./src/features/reactions/index.ts",
      "default": "./src/features/reactions/index.ts"
    },
    "./features/lifecycle": {
      "types": "./src/features/lifecycle/index.ts",
      "default": "./src/features/lifecycle/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "manifest.slack.yaml",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "keywords": [
    "cloudflare",
    "durable-objects",
    "slack",
    "support",
    "websocket"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyaara/cf-slack-support.git"
  },
  "homepage": "https://github.com/skyaara/cf-slack-support#readme",
  "bugs": {
    "url": "https://github.com/skyaara/cf-slack-support/issues"
  }
}
