{
  "name": "cf-slack-support-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Cloudflare Durable Objects + Slack customer support (single publishable package)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/cf-slack-support",
    "packages/integration-tests",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "npm run test:workers -w @cf-slack-support/integration-tests",
    "test:coverage:unit": "vitest run --coverage",
    "test:coverage:workers": "npm run test:coverage -w @cf-slack-support/integration-tests",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:workers"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "4.20250906.0",
    "@types/node": "22.15.30",
    "@vitest/coverage-istanbul": "3.2.4",
    "@vitest/runner": "^3.2.4",
    "@vitest/snapshot": "^3.2.4",
    "fast-check": "4.1.1",
    "hono": "4.13.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.35.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyaara/cf-slack-support.git"
  },
  "homepage": "https://github.com/skyaara/cf-slack-support#readme",
  "bugs": {
    "url": "https://github.com/skyaara/cf-slack-support/issues"
  }
}
